{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doctrine Score",
  "type": "object",
  "required": ["physical_space_score", "emotional_hierarchy_score", "overall_mix_readiness_score", "evidence", "warnings"],
  "properties": {
    "physical_space_score": { "type": ["number", "null"] },
    "emotional_hierarchy_score": { "type": ["number", "null"] },
    "vocal_centrality_score": { "type": ["number", "null"] },
    "depth_hierarchy_score": { "type": ["number", "null"] },
    "section_contrast_score": { "type": ["number", "null"] },
    "static_mix_score": { "type": ["number", "null"] },
    "dynamic_mix_score": { "type": ["number", "null"] },
    "beat_identity_score": { "type": ["number", "null"] },
    "negative_space_score": { "type": ["number", "null"] },
    "groove_coherence_score": { "type": ["number", "null"] },
    "rhythmic_surprise_score": { "type": ["number", "null"] },
    "low_end_motion_score": { "type": ["number", "null"] },
    "loop_context_score": { "type": ["number", "null"] },
    "vocal_role_fit_score": { "type": ["number", "null"] },
    "overall_mix_readiness_score": { "type": ["number", "null"] },
    "evidence": { "type": "object" },
    "warnings": { "type": "array" },
    "confidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["area", "level", "reason"],
        "properties": {
          "area": { "type": "string", "minLength": 1 },
          "level": { "type": "string", "enum": ["high", "limited", "deferred"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
